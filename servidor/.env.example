# Dominio donde vivirá la app (ya apuntando a la IP del servidor). Sin https://
DOMAIN=gps.tuempresa.com

# Contraseña de la base de datos. Pon una larga y difícil; no la necesitarás a diario.
DB_PASSWORD=cambia-esta-contraseña-por-una-larga

# Correo de salida para alertas y recuperar contraseña (opcional, se puede llenar después).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=tu correo, SMTP_PASSWORD=contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Días de historial (recorridos y eventos) que se guardan. Lo más viejo se borra solo cada noche.
# 180 = unos 6 meses. 0 = no borrar nunca (el disco se irá llenando).
HISTORY_DAYS=180

# Avisos en el celular (opcional, ver GUIA.md → "Avisos en el celular").
# Todo en UNA sola línea y entre comillas simples.
NOTIFICATOR_TYPES=web,mail
FIREBASE_WEB_CONFIG=
FIREBASE_SERVICE_ACCOUNT=
